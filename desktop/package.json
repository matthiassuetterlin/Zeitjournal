{
  "name": "zeitjournal-desktop",
  "productName": "Zeitjournal",
  "version": "1.0.0",
  "description": "Zeitjournal als Desktop-Kacheln für Windows",
  "author": "Matthias Sütterlin",
  "main": "main.js",
  "private": true,
  "scripts": {
    "web": "node copy-web.js",
    "start": "npm run web && electron .",
    "dist": "npm run web && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "de.suetterlin.zeitjournal",
    "productName": "Zeitjournal",
    "files": ["main.js", "preload.js", "build-info.json", "web/**", "build/icon.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Zeitjournal-Setup-${version}.${ext}",
      "shortcutName": "Zeitjournal"
    }
  }
}
